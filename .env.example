# ============================================
# Mentoria API — Environment Variables
# ============================================
# Copy file này thành ".env" rồi điền giá trị thật.
# File .env đã được .gitignore — KHÔNG bao giờ commit lên Git.
# ============================================

# JWT Secret (Base64-encoded, 512-bit cho HS512)
# Generate bằng: openssl rand -base64 64
JWT_SECRET=your-base64-jwt-secret-here

# MySQL
DB_PASSWORD=your-db-password-here

# Mailtrap (sandbox email testing)
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
